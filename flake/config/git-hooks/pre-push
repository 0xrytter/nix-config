#!/bin/sh
# Refuse to push a commit no human has stamped as reviewed.
#
# Agents commit freely as checkpoints; pushing is the human's step, so this is
# where the review gate sits. A stamp is a git note under refs/notes/reviewed
# holding a one-line summary in the reviewer's own words, written by `git stamp`
# (modules/home/common.nix) or <leader>gs in a diffview history. A hook cannot
# prove anyone read the diff, so the stamp asks for the one thing a skim cannot
# produce: what the commit does. "skip" is accepted, and stays on record.
#
# Opt a repository out with `git config stamp.skip true`.
set -eu

if [ "$(git config --bool stamp.skip)" = true ]; then
  exit 0
fi

remote="$1"
unstamped=""
# stdin: one "<local ref> <local sha> <remote ref> <remote sha>" line per ref.
while read -r _ local_sha _ remote_sha; do
  # An all-zero sha means the ref does not exist on that side.
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac # deleting a branch
  case "$remote_sha" in
  *[!0]*) commits=$(git rev-list "$remote_sha..$local_sha") ;;
  *) commits=$(git rev-list "$local_sha" --not --remotes="$remote") ;; # new branch
  esac
  for c in $commits; do
    git notes --ref=reviewed show "$c" >/dev/null 2>&1 || unstamped="$unstamped $c"
  done
done

[ -z "$unstamped" ] && exit 0

printf 'pre-push: %s commit(s) not reviewed:\n' "$(echo $unstamped | wc -w)" >&2
for c in $unstamped; do
  git log -1 --format='  %h %s' "$c" >&2
done
printf 'Review them, then `git stamp` (all unpushed, one summary) or <leader>gs per commit, and push again.\n' >&2
exit 1
